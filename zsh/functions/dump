dump() {
  local DOTFILES="${DOTFILES:-$HOME/dotfiles}"
  local extfile="$DOTFILES/vscode/extensions.txt"
  local -a add_files=()

  mkdir -p "$(dirname "$extfile")"

  # Darwin のみ Brewfile を自動 dump（Linux の Aptfile は手動管理のため対象外）
  if [[ "$(uname)" == "Darwin" ]] && command -v brew >/dev/null 2>&1; then
    local brewfile="$DOTFILES/install/Brewfile"
    mkdir -p "$(dirname "$brewfile")"
    local tmp; tmp="$(mktemp)"
    brew bundle dump --force --file=- | grep -v '^vscode' > "$tmp"
    mv "$tmp" "$brewfile"
    add_files+=("$brewfile")
  fi

  # VS Code 拡張の manifest は macOS を正典とし、macOS 以外では書き出さない。
  #   - WSL: PATH 上の code は Windows 側 VS Code に解決され、--list-extensions は
  #     WSL サーバ側の別の拡張集合を返す
  #   - 純 Linux: Aptfile の [linux] が code を導入するため、そのまま書き出すと
  #     Linux 側の拡張一覧で Mac の manifest を潰し、しかも自動 commit まで走る
  # manifest からの導入は一方向（bootstrap は WSL では拡張を入れず、純 Linux では入れる）。
  # 書き出しだけは macOS に一本化しないと、環境ごとに一覧が入れ替わってしまう。
  if [[ "$(uname)" != "Darwin" ]]; then
    echo "dump: macOS 以外のため VS Code 拡張の書き出しをスキップします（manifest は macOS が正典）。"
  elif command -v code >/dev/null 2>&1; then
    local tmp; tmp="$(mktemp)"
    if code --list-extensions > "$tmp"; then
      mv "$tmp" "$extfile"
      add_files+=("$extfile")
    else
      command rm -f "$tmp"
    fi
  fi

  # 対象ファイルだけをステージ・コミットする（無関係な変更を巻き込まない）
  (
    cd "$DOTFILES" || return
    if [[ ${#add_files[@]} -gt 0 ]] && [[ -n "$(git status --porcelain -- "${add_files[@]}")" ]]; then
      git add "${add_files[@]}"
      git status -s -- "${add_files[@]}"
      git commit -m "Update package manifest and VSCode extensions"
      echo "Changes committed."
    else
      echo "No changes."
    fi
  )
}
