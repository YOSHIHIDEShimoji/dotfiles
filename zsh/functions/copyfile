# ファイルをクリップボードにコピー
copyfile() {
	emulate -L zsh
	if [[ "$(uname)" == "Darwin" ]]; then
		cat "$1" | pbcopy
	elif [[ -n "$WSL_DISTRO_NAME" ]] || grep -qi microsoft /proc/version 2>/dev/null; then
		cat "$1" | copy
	else
		cat "$1" | xclip -selection clipboard
	fi
	echo ${(%):-"%B$1%b copied to clipboard."}
}
